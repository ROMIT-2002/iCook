# Serverless / API Port for Local Express Backend
PORT=3001

# Twilio WhatsApp Integration Credentials
# Get your Account SID and Auth Token from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Twilio Sender Number (Sandbox or Production Approved Sender)
# Sandbox format: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Destination Phone Number for Reservation Notifications
# This number must first join the Twilio WhatsApp Sandbox (see README).
RESERVATION_WHATSAPP_TO=whatsapp:+13464558004

# (Optional) Twilio Content Template SID for Approved Production Templates
# TWILIO_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
